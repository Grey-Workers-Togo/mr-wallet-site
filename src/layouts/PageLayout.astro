---
// Adds the shared SiteHeader/Footer around BaseLayout's <head>/<body> shell.
// Split out so BaseLayout stays head-only and reusable (e.g. for a future
// page that wants a bare shell without chrome).
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import Footer from '@/components/Footer.astro';
import type { Locale } from '@/i18n/ui';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { locale, title, description, path, ogImage, ogType, noindex, publishedTime, modifiedTime, jsonLd } = Astro.props;
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  path={path}
  ogImage={ogImage}
  ogType={ogType}
  noindex={noindex}
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  jsonLd={jsonLd}
>
  <SiteHeader locale={locale} path={path} />
  <slot />
  <Footer locale={locale} />
</BaseLayout>
