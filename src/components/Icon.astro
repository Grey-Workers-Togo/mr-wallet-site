---
// Minimal inline SVG icon set — avoids pulling in lucide-react (and React)
// for decorative glyphs on a static page. Paths adapted from Lucide's MIT-
// licensed icon set (https://lucide.dev), stroke-based to match the app.
export type IconName =
  | 'bar-chart'
  | 'smartphone'
  | 'gauge'
  | 'target'
  | 'repeat'
  | 'hand-coins'
  | 'arrow-right'
  | 'check'
  | 'check-circle'
  | 'star'
  | 'globe'
  | 'book'
  | 'sun'
  | 'moon';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = 'size-5' } = Astro.props;

const paths: Record<IconName, string> = {
  'bar-chart': 'M3 3v18h18 M18 17V9 M13 17V5 M8 17v-4',
  smartphone: 'M5 2h14a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Z M12 18h.01',
  gauge: 'M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z M12 2a10 10 0 1 0 10 10 M12 2v3 M4.9 4.9l2.1 2.1 M19.1 4.9l-2.1 2.1',
  target: 'M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Z M12 16a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z M12 12h.01',
  repeat: 'M17 2l4 4-4 4 M3 11V9a4 4 0 0 1 4-4h14 M7 22l-4-4 4-4 M21 13v2a4 4 0 0 1-4 4H3',
  'hand-coins':
    'M11 15h2a2 2 0 1 0 0-4h-3c-.6 0-1.1.2-1.4.6L3 17 M7 21l1.6-1.4c.3-.4.8-.6 1.4-.6h4c1.1 0 2.1-.4 2.8-1.2l3.4-3.4a2 2 0 0 0-2.8-2.8L15 14 M20.4 8.4a3 3 0 1 0-4.8-3.6 3 3 0 0 0 4.8 3.6Z',
  'arrow-right': 'M5 12h14 M12 5l7 7-7 7',
  check: 'M20 6 9 17l-5-5',
  'check-circle': 'M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Z M9 12l2 2 4-4',
  star: 'M12 2l3.1 6.3 6.9 1-5 4.9 1.2 6.8-6.2-3.2-6.2 3.2 1.2-6.8-5-4.9 6.9-1L12 2Z',
  globe:
    'M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Z M2 12h20 M12 2a15 15 0 0 1 4 10 15 15 0 0 1-4 10 15 15 0 0 1-4-10 15 15 0 0 1 4-10Z',
  book: 'M4 19.5A2.5 2.5 0 0 1 6.5 17H20 M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z',
  sun: 'M12 17a5 5 0 1 0 0-10 5 5 0 0 0 0 10Z M12 1v2 M12 21v2 M4.2 4.2l1.4 1.4 M18.4 18.4l1.4 1.4 M1 12h2 M21 12h2 M4.2 19.8l1.4-1.4 M18.4 5.6l1.4-1.4',
  moon: 'M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z',
};
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  {paths[name].split(' M').map((segment, i) => (
    <path d={i === 0 ? segment : `M${segment}`} />
  ))}
</svg>
