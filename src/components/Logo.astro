---
interface Props {
  size?: number;
  class?: string;
  textClass?: string;
}

const { size = 28, class: className = '', textClass = 'text-neutral-900 dark:text-white' } = Astro.props;
---

<span class={`inline-flex items-center gap-2 ${className}`}>
  <img src="/logo-symbol.svg" alt="" width={size} height={size} />
  <span class={`text-lg font-bold ${textClass}`}>Mr Wallet</span>
</span>
