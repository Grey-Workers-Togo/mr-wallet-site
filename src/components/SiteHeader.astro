---
// Static header: no auth-state check (this site never calls the API — see
// CLAUDE.md). The header always shows "Log in" / "Sign up" pointing at
// app.mister-wallet.com; a signed-in visitor just lands on the app's own
// login redirect. Mobile nav uses a <details> disclosure — no JS needed.
import Logo from '@/components/Logo.astro';
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import { useTranslations } from '@/i18n/utils';
import type { Locale } from '@/i18n/ui';

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const t = useTranslations(locale);
const appOrigin = 'https://app.mister-wallet.com';
---

<header class="sticky top-0 z-50 border-b border-neutral-200 bg-white/85 backdrop-blur-md dark:border-white/10 dark:bg-[#0a0a0d]/80">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 md:px-8">
    <a href={`/${locale}`} aria-label="Mr Wallet" class="shrink-0">
      <Logo size={30} />
    </a>

    <nav class="hidden items-center gap-6 text-sm font-medium text-neutral-600 md:flex dark:text-neutral-300">
      <a href={`/${locale}#features`} class="hover:text-neutral-900 dark:hover:text-white">{t('nav.features')}</a>
      <a href={`/${locale}#how`} class="hover:text-neutral-900 dark:hover:text-white">{t('nav.howItWorks')}</a>
      <a href={`/${locale}/pricing`} class="hover:text-neutral-900 dark:hover:text-white">{t('nav.pricing')}</a>
      <a href={`/${locale}/blog`} class="hover:text-neutral-900 dark:hover:text-white">{t('nav.blog')}</a>
      <a href={`/${locale}/faq`} class="hover:text-neutral-900 dark:hover:text-white">{t('nav.faq')}</a>
      <a href={`/${locale}/about`} class="hover:text-neutral-900 dark:hover:text-white">{t('nav.about')}</a>
    </nav>

    <div class="flex items-center gap-1">
      <LanguageSwitcher locale={locale} path={path} />
      <ThemeToggle />
      <a
        href={`${appOrigin}/${locale}/login`}
        class="ml-1 hidden rounded-lg px-3 py-2 text-sm font-medium text-neutral-600 transition-colors hover:bg-neutral-100 hover:text-neutral-900 sm:inline-flex dark:text-neutral-400 dark:hover:bg-white/5 dark:hover:text-white"
      >
        {t('login')}
      </a>
      <a
        href={`${appOrigin}/${locale}/register`}
        class="ml-1 hidden h-9 items-center gap-1.5 rounded-lg bg-neutral-900 px-4 text-sm font-semibold text-white transition-colors hover:bg-neutral-800 sm:inline-flex dark:bg-white dark:text-neutral-900 dark:hover:bg-neutral-200"
      >
        {t('register')}
      </a>

      <details class="relative md:hidden">
        <summary class="flex size-9 list-none items-center justify-center rounded-lg text-neutral-600 hover:bg-neutral-100 dark:text-neutral-300 dark:hover:bg-white/5 [&::-webkit-details-marker]:hidden">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="size-5">
            <path d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </summary>
        <div class="absolute top-11 right-0 flex w-56 flex-col gap-1 rounded-xl border border-neutral-200 bg-white p-3 text-sm font-medium shadow-lg dark:border-white/10 dark:bg-[#0a0a0d]">
          <a href={`/${locale}#features`} class="rounded-lg px-3 py-2 hover:bg-neutral-100 dark:hover:bg-white/5">{t('nav.features')}</a>
          <a href={`/${locale}#how`} class="rounded-lg px-3 py-2 hover:bg-neutral-100 dark:hover:bg-white/5">{t('nav.howItWorks')}</a>
          <a href={`/${locale}/pricing`} class="rounded-lg px-3 py-2 hover:bg-neutral-100 dark:hover:bg-white/5">{t('nav.pricing')}</a>
          <a href={`/${locale}/blog`} class="rounded-lg px-3 py-2 hover:bg-neutral-100 dark:hover:bg-white/5">{t('nav.blog')}</a>
          <a href={`/${locale}/faq`} class="rounded-lg px-3 py-2 hover:bg-neutral-100 dark:hover:bg-white/5">{t('nav.faq')}</a>
          <a href={`/${locale}/about`} class="rounded-lg px-3 py-2 hover:bg-neutral-100 dark:hover:bg-white/5">{t('nav.about')}</a>
          <hr class="my-1 border-neutral-200 dark:border-white/10" />
          <a href={`${appOrigin}/${locale}/login`} class="rounded-lg px-3 py-2 hover:bg-neutral-100 dark:hover:bg-white/5">{t('login')}</a>
          <a href={`${appOrigin}/${locale}/register`} class="rounded-lg bg-neutral-900 px-3 py-2 text-center text-white dark:bg-white dark:text-neutral-900">{t('register')}</a>
        </div>
      </details>
    </div>
  </div>
</header>
