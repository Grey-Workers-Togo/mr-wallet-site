---
import Icon from '@/components/Icon.astro';

interface Props {
  name: string;
  role: string;
  quote: string;
}

const { name, role, quote } = Astro.props;
const initials = name
  .split(' ')
  .map((part) => part[0])
  .join('')
  .slice(0, 2);
---

<div class="flex h-full flex-col gap-3 rounded-2xl border border-neutral-200 bg-white p-6 text-left shadow-sm transition-all hover:-translate-y-1 hover:border-neutral-300 hover:shadow-md dark:border-white/10 dark:bg-white/[0.03] dark:shadow-none dark:hover:border-white/20 dark:hover:bg-white/[0.05]">
  <div class="flex gap-0.5 text-amber-400">
    {Array.from({ length: 5 }).map(() => <Icon name="star" class="size-4 fill-current" />)}
  </div>
  <p class="text-[0.95rem] leading-relaxed text-neutral-700 dark:text-neutral-300">&ldquo;{quote}&rdquo;</p>
  <div class="mt-2 flex items-center gap-3">
    <div class="flex size-10 shrink-0 items-center justify-center rounded-full bg-neutral-100 text-sm font-semibold text-neutral-700 dark:bg-white/10 dark:text-neutral-100">
      {initials}
    </div>
    <div>
      <p class="text-sm font-medium text-neutral-900 dark:text-neutral-100">{name}</p>
      <p class="text-xs text-neutral-500">{role}</p>
    </div>
  </div>
</div>
