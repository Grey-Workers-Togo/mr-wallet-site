---
import { getCollection, render } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import { locales, useTranslations } from '@/i18n/utils';
import type { Locale } from '@/i18n/ui';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);
const allEntries = await getCollection('faq');
const entries = allEntries
  .filter((entry) => entry.id.startsWith(`${locale}/`))
  .sort((a, b) => a.data.order - b.data.order);

const rendered = await Promise.all(entries.map((entry) => render(entry)));

// FAQPage JSON-LD — this is what generative search engines cite (docs/16, Phase 3 AEO/GEO).
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: entries.map((entry) => ({
    '@type': 'Question',
    name: entry.data.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: entry.data.answer,
    },
  })),
};
---

<PageLayout locale={locale} title={t('faq.title')} description={t('faq.description')} path="/faq" jsonLd={jsonLd}>
  <main class="mx-auto max-w-2xl px-4 py-16">
    <h1 class="text-3xl font-bold tracking-tight text-neutral-900 dark:text-neutral-50">{t('faq.title')}</h1>
    <div class="mt-8 divide-y divide-neutral-200 dark:divide-white/10">
      {entries.map((entry, i) => {
        const { Content } = rendered[i];
        return (
          <details class="group py-4">
            <summary class="cursor-pointer list-none text-base font-medium text-neutral-900 marker:content-none dark:text-neutral-100">
              {entry.data.question}
            </summary>
            <div class="mt-2 text-[0.95rem] leading-relaxed text-neutral-600 dark:text-neutral-400">
              <Content />
            </div>
          </details>
        );
      })}
    </div>
  </main>
</PageLayout>
