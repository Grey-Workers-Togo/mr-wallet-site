---
import PageLayout from '@/layouts/PageLayout.astro';
import { locales, useTranslations } from '@/i18n/utils';
import { designedForReasons } from '@/i18n/content';
import { breadcrumbSchema, organizationSchema, SITE_URL } from '@/lib/schema';
import type { Locale } from '@/i18n/ui';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);
const reasons = designedForReasons[locale];
const appOrigin = 'https://app.mister-wallet.com';

const principles = [
  { key: 'p1', href: `/${locale}/blog/why-not-floats-for-money` },
  { key: 'p2', href: `/${locale}/faq` },
  { key: 'p3', href: undefined },
  { key: 'p4', href: `/${locale}/account-deletion` },
  { key: 'p5', href: 'https://github.com/Grey-Workers-Togo/mr-wallet' },
] as const;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: t('about.title'),
    url: `${SITE_URL}/${locale}/about`,
    inLanguage: locale,
    mainEntity: organizationSchema(),
  },
  breadcrumbSchema([
    { name: 'Mr Wallet', url: `${SITE_URL}/${locale}` },
    { name: t('nav.about') },
  ]),
];
---

<PageLayout
  locale={locale}
  title={t('about.title')}
  description={t('about.description')}
  path="/about"
  jsonLd={jsonLd}
>
  <main class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-3xl font-bold tracking-tight text-neutral-900 md:text-5xl dark:text-neutral-50">
      {t('about.h1')}
    </h1>
    <p class="mt-5 text-lg leading-relaxed text-neutral-600 dark:text-neutral-400">{t('about.answer')}</p>

    <section class="mt-14">
      <h2 class="text-2xl font-semibold text-neutral-900 dark:text-neutral-100">{t('about.whoTitle')}</h2>
      <p class="mt-3 leading-relaxed text-neutral-600 dark:text-neutral-400">{t('designedFor.description')}</p>
      <ul class="mt-4 list-disc space-y-2 pl-5 text-neutral-700 dark:text-neutral-300">
        {reasons.map((reason) => <li>{reason}</li>)}
      </ul>
    </section>

    <section class="mt-14">
      <h2 class="text-2xl font-semibold text-neutral-900 dark:text-neutral-100">{t('about.principlesTitle')}</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {principles.map((p) => (
          <div class="rounded-2xl border border-neutral-200 bg-white p-5 dark:border-white/10 dark:bg-white/[0.03]">
            <h3 class="font-semibold text-neutral-900 dark:text-neutral-100">
              {p.href ? (
                <a
                  href={p.href}
                  class="underline-offset-4 hover:underline"
                  {...(p.href.startsWith('http') ? { target: '_blank', rel: 'noreferrer' } : {})}
                >
                  {t(`about.${p.key}.title`)}
                </a>
              ) : (
                t(`about.${p.key}.title`)
              )}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">{t(`about.${p.key}.body`)}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mt-14">
      <h2 class="text-2xl font-semibold text-neutral-900 dark:text-neutral-100">{t('about.publisherTitle')}</h2>
      <p class="mt-3 leading-relaxed text-neutral-600 dark:text-neutral-400">
        {t('about.publisherBody')}{' '}
        <a href="mailto:contact@mister-wallet.com" class="text-primary underline underline-offset-4">contact@mister-wallet.com</a>.
      </p>
    </section>

    <section class="mt-14 flex flex-wrap gap-3">
      <a
        href={`${appOrigin}/${locale}/register`}
        class="inline-flex h-11 items-center justify-center rounded-xl bg-neutral-900 px-6 text-sm font-semibold text-white transition-colors hover:bg-neutral-800 dark:bg-white dark:text-neutral-900 dark:hover:bg-neutral-200"
      >
        {t('register')}
      </a>
      <a
        href={`/${locale}/pricing`}
        class="inline-flex h-11 items-center justify-center rounded-xl border border-neutral-300 px-6 text-sm font-semibold text-neutral-700 transition-colors hover:bg-neutral-100 dark:border-white/15 dark:text-neutral-100 dark:hover:bg-white/5"
      >
        {t('nav.pricing')}
      </a>
    </section>
  </main>
</PageLayout>
