---
import { getEntry } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import PricingCard from '@/components/PricingCard.astro';
import { locales, useTranslations } from '@/i18n/utils';
import { pricingPlans } from '@/i18n/content';
import { breadcrumbSchema, SITE_URL } from '@/lib/schema';
import type { Locale } from '@/i18n/ui';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);
const plans = pricingPlans[locale];
const appOrigin = 'https://app.mister-wallet.com';

// The "is it really free?" answer lives in the FAQ collection; reuse it so the two never drift.
const faqEntry = await getEntry('faq', `${locale}/gratuit-pro`);
if (!faqEntry) throw new Error(`faq entry "${locale}/gratuit-pro" is missing`);

const pageUrl = `${SITE_URL}/${locale}/pricing`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Mr Wallet',
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Web, Android',
    url: `${SITE_URL}/${locale}`,
    inLanguage: locale,
    offers: {
      '@type': 'Offer',
      name: plans[0].name,
      price: '0',
      priceCurrency: 'USD',
      url: pageUrl,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: faqEntry.data.question,
        acceptedAnswer: { '@type': 'Answer', text: faqEntry.data.answer },
      },
    ],
  },
  breadcrumbSchema([
    { name: 'Mr Wallet', url: `${SITE_URL}/${locale}` },
    { name: t('nav.pricing') },
  ]),
];
---

<PageLayout
  locale={locale}
  title={t('pricingPage.title')}
  description={t('pricingPage.description')}
  path="/pricing"
  jsonLd={jsonLd}
>
  <main class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-3xl font-bold tracking-tight text-neutral-900 md:text-5xl dark:text-neutral-50">
      {t('pricingPage.h1')}
    </h1>
    <p class="mt-5 text-lg leading-relaxed text-neutral-600 dark:text-neutral-400">{t('pricingPage.answer')}</p>

    <div class="mt-14 grid gap-6 md:grid-cols-2">
      {plans.map((plan) => <PricingCard {...plan} />)}
    </div>

    <section class="mt-16">
      <h2 class="text-xl font-semibold text-neutral-900 dark:text-neutral-100">{t('pricingPage.proTitle')}</h2>
      <p class="mt-3 leading-relaxed text-neutral-600 dark:text-neutral-400">
        {t('pricingPage.proBody')}{' '}
        <a
          href="mailto:contact@mister-wallet.com?subject=Mr%20Wallet%20Pro"
          class="text-primary underline underline-offset-4"
        >contact@mister-wallet.com</a>.
      </p>
    </section>

    <section class="mt-16">
      <h2 class="text-xl font-semibold text-neutral-900 dark:text-neutral-100">{t('pricingPage.faqTitle')}</h2>
      <div class="mt-4 rounded-2xl border border-neutral-200 bg-white p-6 dark:border-white/10 dark:bg-white/[0.03]">
        <h3 class="font-medium text-neutral-900 dark:text-neutral-100">{faqEntry.data.question}</h3>
        <p class="mt-2 text-[0.95rem] leading-relaxed text-neutral-600 dark:text-neutral-400">{faqEntry.data.answer}</p>
      </div>
      <a href={`/${locale}/faq`} class="mt-4 inline-block text-sm text-primary underline underline-offset-4">
        {t('pricingPage.faqMore')}
      </a>
    </section>

    <section class="mt-16 rounded-2xl border border-primary/30 bg-primary/[0.06] p-8 text-center">
      <h2 class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-neutral-50">{t('pricingPage.ctaTitle')}</h2>
      <a
        href={`${appOrigin}/${locale}/register`}
        class="mt-5 inline-flex h-11 items-center justify-center rounded-xl bg-neutral-900 px-6 text-sm font-semibold text-white transition-colors hover:bg-neutral-800 dark:bg-white dark:text-neutral-900 dark:hover:bg-neutral-200"
      >
        {t('register')}
      </a>
    </section>
  </main>
</PageLayout>
