---
// Migrated from apps/web/src/app/[locale]/account-deletion/page.tsx in the
// mr-wallet repo (docs/16-marketing-site-split.md, Phase 2/4). Kept at the
// same URL — /[locale]/account-deletion — since it's already indexed and the
// Play Store data-safety form links here directly; it does NOT move under
// /legal/ like privacy/terms.
import PageLayout from '@/layouts/PageLayout.astro';
import Logo from '@/components/Logo.astro';
import { locales, useTranslations } from '@/i18n/utils';
import type { Locale } from '@/i18n/ui';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);
---

<PageLayout locale={locale} title={t('accountDeletion.title')} description={t('accountDeletion.intro')} path="/account-deletion">
  <main class="mx-auto flex max-w-2xl flex-col gap-8 px-4 py-16">
    <a href={`/${locale}`}>
      <Logo size={32} />
    </a>

    <h1 class="text-3xl font-semibold text-neutral-900 dark:text-neutral-100">{t('accountDeletion.title')}</h1>
    <p class="text-neutral-600 dark:text-neutral-400">{t('accountDeletion.intro')}</p>

    <div class="rounded-2xl border border-neutral-200 bg-white p-6 dark:border-white/10 dark:bg-white/[0.03]">
      <h2 class="font-semibold text-neutral-900 dark:text-neutral-100">{t('accountDeletion.selfServiceTitle')}</h2>
      <ol class="mt-4 list-decimal space-y-1 pl-5 text-neutral-700 dark:text-neutral-300">
        <li>{t('accountDeletion.selfServiceStep1')}</li>
        <li>{t('accountDeletion.selfServiceStep2')}</li>
        <li>{t('accountDeletion.selfServiceStep3')}</li>
      </ol>
      <p class="mt-3 text-sm text-neutral-500 dark:text-neutral-400">{t('accountDeletion.selfServiceNote')}</p>
      <a
        href={t('accountDeletion.loginHref')}
        class="mt-4 inline-flex h-10 items-center rounded-lg bg-neutral-900 px-4 text-sm font-semibold text-white transition-colors hover:bg-neutral-800 dark:bg-white dark:text-neutral-900 dark:hover:bg-neutral-200"
      >
        {t('login')}
      </a>
    </div>

    <div class="rounded-2xl border border-neutral-200 bg-white p-6 dark:border-white/10 dark:bg-white/[0.03]">
      <h2 class="font-semibold text-neutral-900 dark:text-neutral-100">{t('accountDeletion.noAccessTitle')}</h2>
      <p class="mt-3 text-neutral-700 dark:text-neutral-300">
        {t('accountDeletion.noAccessBody')}{' '}
        <a href={`mailto:${t('accountDeletion.contactLink')}`} class="text-primary underline">
          {t('accountDeletion.contactLink')}
        </a>
      </p>
    </div>
  </main>
</PageLayout>
